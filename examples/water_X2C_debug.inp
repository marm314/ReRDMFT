# Example ReRDMFT input file: water molecule. DEBUG TRUE runs the DEBUG
# cross-checks (the O(n^4) efficient gradient, the finite-difference
# test, for NON_REL, C4_DHF, AND X2C-HF). HESSIAN_MEAN_FIELD is independent of DEBUG: it builds and
# diagonalizes the FULL cheap orbital-rotation Hessian to confirm
# NON_REL and X2C-HF are genuine minima (X2C-HF has no negative-energy
# branch to admit a downhill rotation into, unlike C4_DHF) and C4_DHF a
# saddle point.
NELEC 10
BASIS water-sto-3g.gbs
X2C TRUE
NON_RELATIVISTIC TRUE
DEBUG TRUE
HESSIAN_MEAN_FIELD TRUE

GEOMETRY
O   0.000000   0.000000   0.000000
H   0.000000   0.757000   0.586000
H   0.000000  -0.757000   0.586000
END
