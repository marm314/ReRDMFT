# Minimal validation example for FUNCTIONAL_POS_CHO_4C: LiH, 6-31G, GNOF, FULL_OPTIMIZATION TRUE
# with CHOLESKY TRUE + FUNCTIONAL_POS_CHO_4C TRUE -- the positive-energy MO Cholesky vectors are
# built DIRECTLY (C4_DHF/RkbMoDirectCholesky.h), never building the RKB AO-basis Cholesky vectors
# (RkbCholesky) at all. Compare the converged energy against
# lih_gnof_c4_full_optimization_cholesky.inp's own result (same system, old RkbCholesky-based
# path) -- must match exactly.
ON_DEMAND_ERI TRUE
NELEC 4
BASIS lih-6-31g.gbs
C4_SPINOR TRUE
SCF_DIRECT_4C FALSE  # preserve this example's pre-existing SCF path (SCF_DIRECT_4C now defaults TRUE for plain C4_SPINOR runs)
FUNCTIONAL GNOF
PNOF_SUBSPACES 2
PNOF_COUPLING 2
FULL_OPTIMIZATION TRUE
CHOLESKY TRUE
FUNCTIONAL_POS_CHO_4C TRUE

GEOMETRY
Li  0.000000   0.000000   0.000000
H   0.000000   0.000000   1.594900
END
