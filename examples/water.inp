# Example ReRDMFT input file: water molecule
NELEC 10
BASIS water-sto-3g.gbs
C4_SPINOR TRUE
SCF_DIRECT_4C FALSE  # preserve this example's pre-existing SCF path (SCF_DIRECT_4C now defaults TRUE for plain C4_SPINOR runs)
NON_RELATIVISTIC TRUE

GEOMETRY
O   0.000000   0.000000   0.000000
H   0.000000   0.757000   0.586000
H   0.000000  -0.757000   0.586000
END
